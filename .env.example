PORT=4000

# Use a remote Turso database URL and auth token. Local SQLite/file URLs are not supported.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Set a random JWT secret with at least 32 characters to keep sessions stable if the DB token rotates.
# When omitted, the signing secret is derived from the server-only Turso auth token.
JWT_SECRET=
# Use a strong private passcode; there is no default passcode.
ADMIN_PASSCODE=

# Optional comma-separated browser origins. Omit for wildcard CORS (API uses bearer tokens, not cookies).
# For production, set this to the exact frontend origin(s), e.g. https://nyumba.example.com
ALLOWED_ORIGINS=

PAYMENT_GATEWAY_URL=https://parero.vercel.app

# Optional password-reset email configuration. Set all values to enable the feature.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_ID=
